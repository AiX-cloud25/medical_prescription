# Offline Prescription Extractor — environment (example)
# Copy to .env and fill in the SQL credentials.

# ── Server bind ───────────────────────────────────────────────
# Set to 0.0.0.0 when running on Jarvis Labs / any cloud VM so the
# reverse proxy can reach the server. Keep 127.0.0.1 for local-only.
APP_HOST=0.0.0.0

# ── Ollama (vision model) ─────────────────────────────────────
# Use qwen2.5vl:72b on a GPU box (Jarvis Labs) for production quality;
# qwen2.5vl:7b works for local dev. Point OLLAMA_HOST at a remote
# Ollama server if it is not on this machine.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT=900
OLLAMA_NUM_CTX=16384

# ── Extraction quality knobs ──────────────────────────────────
# VERIFY_MISSED_LINES=1: second completeness pass on handwritten pages
# only — recovers skipped lines at the cost of ~2x latency per page.
VERIFY_MISSED_LINES=1
# DETECT_DIAGRAMS=1: dedicated grounding pass for hand-drawn clinical
# drawings (better crops, no logo/emblem crops). 0 = inline boxes only.
DETECT_DIAGRAMS=1
# HEADER_CHECK=1 (always): re-read the top strip of every page and
# prepend missing header lines. "suspect" = only header-less-looking
# pages; 0 = off.
HEADER_CHECK=1
# AUDIT_WORDS=1: critic pass flags misread words in red (one extra call
# per handwritten page). 0 = off.
AUDIT_WORDS=1
# Long-edge pixel cap for image crops embedded into the layout.
CROP_MAX_EDGE=500
# Padding (page %) added around a crop box.
CROP_PAD_PCT=4.0

# ── MedGemma medical-word correction (post-extraction layer) ──
# Proposes wrong->correct pairs for misread medical terms; applied
# corrections appear prefixed with * in raw text and layout.
# Set MEDGEMMA_CORRECTION=0 to disable the layer entirely.
MEDGEMMA_CORRECTION=1
MEDGEMMA_MODEL=williamljx/medgemma-4b-it-Q4_K_M-GGUF
MEDGEMMA_TIMEOUT=300

# ── Azure SQL (correction-feedback learning) ──────────────────
# Same server/database as the GPT sibling but its OWN schema — each
# model learns from its own mistakes. If the DB is unreachable the
# app still works; only correction saving/learning is disabled.
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=your-database
SQL_USERNAME=your-username
SQL_PASSWORD=your-password
SQL_SCHEMA=PrescriptionExtractionOffline
